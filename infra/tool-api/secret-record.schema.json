{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed tool-only secret record; schema contains no credentials",
  "type": "object",
  "additionalProperties": false,
  "required": ["toolServerKeyPem", "toolServerCertificatePem", "workloadClientCaPem", "outboundCaPem", "policySigningKeyPem", "auditHmacKeyHex"],
  "properties": {
    "toolServerKeyPem": {"type": "string", "minLength": 1, "maxLength": 16384},
    "toolServerCertificatePem": {"type": "string", "minLength": 1, "maxLength": 65536},
    "workloadClientCaPem": {"type": "string", "minLength": 1, "maxLength": 65536},
    "outboundCaPem": {"type": "string", "minLength": 1, "maxLength": 65536},
    "policySigningKeyPem": {"type": "string", "minLength": 1, "maxLength": 16384},
    "auditHmacKeyHex": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
